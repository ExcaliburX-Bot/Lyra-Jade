  {
    "id": "35c35401b0",
    "title": "Perplexity Computer Brain now auto-creates self-improving agent skills",
    "url": "https://x.com/perplexity_ai/status/2123449395882701224",
    "publisher": "@perplexity_ai",
    "tier": "official",
    "published": "2026-11-19T16:12:42.000Z",
    "score": 3.6,
    "category_hint": "product",
    "text": "Computer's personalized self-improvement agent, Brain, now automatically creates self-improving agent skills for you.\n\nBrain learns how you work from past sessions and memory, then writes and updates personalized skills for future tasks.",
    "via": "https://x.com/perplexity_ai/status/2123449395882701224",
    "related": [
      {
        "title": "Perplexity Computer's Brain now writes and updates self-improving agent skills.",
        "url": "https://www.perplexity.ai/hub/blog/self-improving-skills",
        "publisher": "@AravSrinivas",
        "tier": "official",
        "text": "Sharing new research on self-improving skills in Perplexity Computer. Brain, which already maintains a knowledge wiki about your work, now also writes and updates agent skills for you based on your past sessions. An improvement agent reads the full session trajectories (tool calls, reasoning, results), finds recurring patterns, and only proposes a new skill or an update when there’s enough evidence. Built-in skills that every user gets go through paired replay on failure scenarios and engineer review before any change goes live. In an 8-week randomized test on production traffic, 72.9% of users got at least one new personal skill vs 6.5% who added one manually. Tool call failures dropped 11% and dissatisfied threads dropped 7.6%, with no measurable change in cost or latency.\n\nBlog post with more details: https://www.perplexity.ai/hub/blog/self-improving-skills"
      }
    ]
  },
