    "id": "f7ba30b47f",
    "title": "Responses API now ties GPT-6.2 reasoning items to earlier conversation history",
    "url": "https://x.com/OpenAIDevs/status/2123566018866151579",
    "publisher": "@OpenAIDevs",
    "tier": "official",
    "published": "2026-11-19T23:56:07.000Z",
    "score": 5.1,
    "category_hint": "product",
    "text": "Agents using GPT-6.2 in the Responses API can build on earlier reasoning to deliver better results with fewer tokens and more cache hits.\n\nStarting with our newest frontier models, each reasoning item is now tied to the conversation history before it, so editing earlier messages causes the API to drop reasoning that follows the change.",
    "via": "https://x.com/OpenAIDevs/status/2123566018866151579",
    "related": []
  },
